{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser" },
      "digestAlgorithm": "sha256"
    }
  },
  "plugins": {
    "updater": { "windows": { "installMode": "passive" } }
  }
}
